[Unit]
Description=PNS FastAPI backend
After=network.target

[Service]
Type=simple
User=pns
Group=pns
WorkingDirectory=/opt/pns/backend
Environment=NODE_ENV=production
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pns/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
