APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_AUTH_STORE_PATH=../data/admin-auth-store.json
PNS_IMAGE_MANIFEST=../data/uploads/image-manifest.json
PNS_IMAGE_STORAGE_DIR=../public/uploads
PNS_IMAGE_BACKEND=file
PNS_SECURE_COOKIES=false
PNS_COOKIE_SAMESITE=lax
PNS_COOKIE_DOMAIN=
PNS_API_DOCS_ENABLED=false
PNS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,your-domain.example
# Configure this only after a persistent Supabase Storage bucket exists.
# PNS_IMAGE_STORAGE_BUCKET=your-existing-public-image-bucket
